# Create an application in Clerk and provide its keys through your local
# environment or Replit Secrets. Never commit real keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# For local development outside Replit, use your own PostgreSQL connection string.
# Replit injects its managed development/production DATABASE_URL automatically.
DATABASE_URL=postgresql://user:password@host:5432/database
PORT=3000
