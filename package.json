{
  "name": "workout-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.80",
    "@clerk/react": "^6.17.8",
    "dotenv": "^17.2.2",
    "express": "^4.22.2",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.0.2"
  }
}
